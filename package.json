{
  "name": "android-qa-automation-framework",
  "version": "1.0.0",
  "description": "Android QA framework: Appium (UiAutomator2) automation, adb tooling, security and network checks, API tests, test documentation and Linux helper scripts.",
  "type": "module",
  "scripts": {
    "doctor": "bash scripts/check_env.sh",
    "setup:appium": "appium driver install uiautomator2",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:api": "node --import tsx --test \"tests/api/**/*.test.ts\"",
    "setup:browsers": "playwright install chromium",
    "test:mobile-web": "playwright test",
    "test:mobile-web:pixel": "playwright test --project=pixel-7",
    "test:mobile-web:headed": "playwright test --project=pixel-7 --headed",
    "report:mobile-web": "playwright show-report reports/playwright",
    "test:device": "wdio run wdio.conf.ts",
    "test:smoke": "wdio run wdio.conf.ts --mochaOpts.grep @smoke",
    "test:security": "wdio run wdio.conf.ts --spec tests/device/security.spec.ts",
    "test:network": "wdio run wdio.conf.ts --spec tests/device/network.spec.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "android",
    "appium",
    "webdriverio",
    "qa",
    "adb",
    "test-automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.0.0",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.9.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "webdriverio": "^10.2.0"
  }
}
