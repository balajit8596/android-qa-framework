# App under test (defaults to the stock Android Settings app, so it runs on any emulator)
APP_PACKAGE=com.android.settings
APP_ACTIVITY=.Settings
# Optional: path to an APK to install and test instead
# APP_PATH=./apps/my-app.apk

DEVICE_NAME=Android Emulator
# Optional: target a specific device when several are connected (see `adb devices`)
# ANDROID_SERIAL=emulator-5554
# Optional: full path to adb if it is not on PATH
# ADB_PATH=C:\\Users\\you\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe

# Backend service used by the API tests
API_BASE_URL=https://jsonplaceholder.typicode.com

# Comma-separated permissions the app must NOT be granted (security audit)
# FORBIDDEN_PERMISSIONS=android.permission.READ_SMS,android.permission.RECORD_AUDIO
